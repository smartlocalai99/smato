<?xml version="1.0" encoding="utf-8"?>
<!-- force-lock is specifically the policy DevicePolicyManager.lockNow()
     requires a Device Administrator to declare — nothing else is needed
     since this app has no interest in password rules, encryption, or any
     other admin policy. -->
<device-admin xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-policies>
        <force-lock />
    </uses-policies>
</device-admin>
